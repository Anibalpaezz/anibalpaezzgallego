# ── Supabase ──
# Project id + anon/publishable key (safe to expose in the browser bundle).
PUBLIC_SUPABASE_PROJECT_ID=""
PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Server-only key used by src/lib/supabase-server.ts (src/pages/api/consent.ts).
# NEVER prefix this with PUBLIC_ and NEVER reference it from client code.
# Get it from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=""

# ── EmailJS ──
# Get these values from https://dashboard.emailjs.com
PUBLIC_EMAILJS_SERVICE_ID=""
PUBLIC_EMAILJS_TEMPLATE_ID=""
PUBLIC_EMAILJS_PUBLIC_KEY=""

# ── SQL Sandbox (MySQL tab) ──
# The sandbox runs PostgreSQL fully in the browser (PGlite, no credentials
# needed). This optional MySQL tab sends queries to a real instance through the
# serverless route /api/sql/mysql. Leave empty to disable it.
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE=""
