# ── GitHub ──
# Personal Access Token (server-side only, used at build time by
# scripts/fetch-github-stats.mjs to fetch the contribution calendar via
# GraphQL). Get one at https://github.com/settings/tokens (scope: read:user).
# NEVER prefix with PUBLIC_ and NEVER reference it from client code.
# If missing, the script falls back to the public REST API (no calendar data).
GITHUB_TOKEN=""

# ── Supabase ──
# Project id + anon/publishable key (safe to expose in the browser bundle).
PUBLIC_SUPABASE_PROJECT_ID=""
PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Server-only key used by src/lib/supabase-server.ts
# (src/pages/api/consent.ts and src/pages/api/propina-*.ts).
# NEVER prefix this with PUBLIC_ and NEVER reference it from client code.
# Get it from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=""

# ── EmailJS ──
# Get these values from https://dashboard.emailjs.com
PUBLIC_EMAILJS_SERVICE_ID=""
PUBLIC_EMAILJS_TEMPLATE_ID=""
PUBLIC_EMAILJS_PUBLIC_KEY=""
