---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "../styles/global.css";
import CookieConsent from "@/react/CookieConsent";
import { seoMeta, canonicalUrl, routeKeyFromPath, t } from "@/lib/t";

export interface Props {
  title?: string;
  description?: string;
  lang?: "es" | "en" | "fr" | "de" | "zh";
  seoKey?:
    | "home"
    | "about"
    | "projects"
    | "resume"
    | "blog"
    | "contact"
    | "404"
    | "propinas";
}

const { lang = "es", seoKey, title, description } = Astro.props;

const site = (
  Astro.site?.toString() ?? "https://anibalpaezzgallego.com"
).replace(/\/+$/, "");

const key =
  seoKey ??
  (routeKeyFromPath(Astro.url.pathname) as NonNullable<Props["seoKey"]>);
const meta = seoMeta(lang, key);
const pageTitle = title ?? meta.title;
const pageDescription = description ?? meta.description;

const is404 = key === "404";
const canonical = is404
  ? undefined
  : canonicalUrl(lang, Astro.url.pathname, site);
const ogImageUrl = new URL("/photos/og-image.png", site).toString();

const ogLocale: Record<NonNullable<Props["lang"]>, string> = {
  es: "es_ES",
  en: "en_US",
  fr: "fr_FR",
  de: "de_DE",
  zh: "zh_CN",
};

const personLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Aníbal Páez Gallego",
  url: `${site}/`,
  jobTitle: "Full-Stack Developer",
  worksFor: { "@type": "Organization", name: "Arktic" },
  knowsAbout: [
    "React",
    "TypeScript",
    "Node.js",
    "PostgreSQL",
    "SQL",
    "Supabase",
    "Tailwind CSS",
    "Python",
  ],
  sameAs: [
    "https://github.com/Anibalpaezz",
    "https://www.linkedin.com/in/anibalpg/",
    "https://t.me/anibalpaezzg",
  ],
  nationality: "ES",
});

const websiteLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Aníbal Páez Gallego — Portfolio",
  url: `${site}/`,
  inLanguage: lang,
  description: pageDescription,
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Aníbal Páez Gallego" />

    {is404 && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Aníbal Páez Gallego — Portfolio" />
    <meta property="og:locale" content={ogLocale[lang]} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" is:inline set:html={personLd} />
    <script type="application/ld+json" is:inline set:html={websiteLd} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      (function () {
        var theme = localStorage.getItem("theme") || "dark";
        document.documentElement.classList.remove("light", "dark");
        document.documentElement.classList.add(theme);
      })();
    </script>

    <script is:inline>
      (function () {
        var SEASONS = ["primavera", "verano", "otono", "invierno"];
        var season = null;
        try {
          var stored = localStorage.getItem("theme_season");
          if (SEASONS.indexOf(stored) !== -1) season = stored;
        } catch (e) {}

        if (!season) {
          var m = 0;
          var d = 0;
          try {
            var parts = new Intl.DateTimeFormat("en-CA", {
              timeZone: "Europe/Madrid",
              year: "numeric",
              month: "2-digit",
              day: "2-digit",
            }).format(new Date());
            var match = /-(\d{2})-(\d{2})$/.exec(parts);
            if (match) {
              m = parseInt(match[1], 10);
              d = parseInt(match[2], 10);
            }
          } catch (e) {}

          if (!m) {
            var now = new Date();
            m = now.getMonth() + 1;
            d = now.getDate();
          }

          if (
            (m === 3 && d >= 21) ||
            (m > 3 && m < 6) ||
            (m === 6 && d <= 20)
          ) {
            season = "primavera";
          } else if (
            (m === 6 && d >= 21) ||
            (m > 6 && m < 9) ||
            (m === 9 && d <= 22)
          ) {
            season = "verano";
          } else if (
            (m === 9 && d >= 23) ||
            (m > 9 && m < 12) ||
            (m === 12 && d <= 20)
          ) {
            season = "otono";
          } else {
            season = "invierno";
          }
        }

        document.documentElement.setAttribute("data-season", season);
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground"
    >
      {t(lang, "accessibility.skipToContent")}
    </a>
    <slot name="nav" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />

    <CookieConsent lang={lang} client:load />

    <button
      id="scroll-top"
      class="hidden fixed bottom-6 right-6 z-50 items-center justify-center rounded-full bg-primary hover:bg-primary/90 shadow-lg transition-all animate-fade-in w-10 h-10"
      aria-label={t(lang, "accessibility.scrollTop")}
    >
      <svg
        class="h-5 w-5 text-primary-foreground"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg
      >
    </button>

    <script>
      import "@/scripts/app";
    </script>
  </body>
</html>
