// Calcula el número de columnas que hace que la cuadrícula quede lo más
// cuadrada posible: sin celdas vacías si se puede, con filas y columnas
// equilibradas y, en caso de empate, con más columnas.
function bestColumns(count: number): number {
  let best = 1;
  let bestEmpty = Infinity;
  let bestDiff = Infinity;
  for (let c = 1; c <= count; c++) {
    const rows = Math.ceil(count / c);
    const empty = rows * c - count;
    const diff = Math.abs(rows - c);
    if (
      empty < bestEmpty ||
      (empty === bestEmpty && diff < bestDiff) ||
      (empty === bestEmpty && diff === bestDiff && c > best)
    ) {
      bestEmpty = empty;
      bestDiff = diff;
      best = c;
    }
  }
  return best;
}

const columns = bestColumns(projects.length);
const mdColumns = Math.min(2, columns);
---

<div class="min-h-screen py-16 md:py-24">
  <div class="container mx-auto px-4 md:px-8">
    <div class="max-w-2xl mx-auto text-center mb-12 animate-fade-in">
      <h1 class="text-3xl md:text-5xl font-bold mb-3 tracking-tight">{t(lang, "projects.title")}</h1>
      <p class="text-base md:text-lg text-muted-foreground">{t(lang, "projects.subtitle")}</p>
    </div>

    <div
      class="proj-grid max-w-6xl mx-auto grid gap-6"
      style={`--cols-lg: ${columns}; --cols-md: ${mdColumns};`}
    >
      {projects.map((project) => (
        <ProjectCard lang={lang} project={project} />
      ))}
    </div>
  </div>
</div>

<style>
  :global(.proj-grid) {
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
  @media (min-width: 768px) {
    :global(.proj-grid) {
      grid-template-columns: repeat(var(--cols-md, 2), minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    :global(.proj-grid) {
      grid-template-columns: repeat(var(--cols-lg, 3), minmax(0, 1fr));
    }
  }
</style>